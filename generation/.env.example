# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenRouter (optionnel — requis uniquement si DIALOGUE_MODEL n'est pas un modèle Claude)
# Obtenir sur https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# ---------------------------------------------------------------------------
# Modèles IA par tâche — juin 2026
# ---------------------------------------------------------------------------
# Sélection du modèle : Claude (Anthropic) ou tiers via OpenRouter
# Format OpenRouter : "provider/model-id" ex: "deepseek/deepseek-v4-flash"
#
# Référence tarifaire ($/M tokens input/output) :
#   claude-haiku-4-5-20251001      $1.00 / $5.00  — stable, testé
#   claude-sonnet-4-6              $3.00 / $15.00 — meilleur JSON structuré 30+ champs
#   deepseek/deepseek-v4-flash     $0.14 / $0.28  — -86% vs Haiku, nécessite OPENROUTER_API_KEY
#   deepseek/deepseek-v4-pro       $0.44 / $0.87  — -56% vs Haiku, plus robuste
# ---------------------------------------------------------------------------

# Dialogue NL→JSON atomique
# Recommandé : Haiku 4.5 (stable, éprouvé)
# Alternative : DeepSeek V4-Flash via OpenRouter (-86% coût, JSON mode fiable, texte uniquement)
DIALOGUE_MODEL=claude-haiku-4-5-20251001
# DIALOGUE_MODEL=deepseek/deepseek-v4-flash

# Vision plans + extraction programme depuis CdC
# Recommandé : Sonnet 4.6 (seul modèle validé sur schéma 30+ champs sans JSON-repair fallback)
# Alternatives testées mais JSON compliance inférieure sur schéma complexe :
#   Gemini 3.5 Flash $1.50/$9 — meilleure perception visuelle pure
#   Qwen3-VL-235B   $0.26/$2.60 — multimodal moins cher mais non validé en prod Western
VISION_MODEL=claude-sonnet-4-6

# Génération programme initial depuis CdC (structured outputs beta)
PROGRAMME_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Génération
# ---------------------------------------------------------------------------
GENERATION_OUTPUT_DIR=/tmp/generation-output
PYTHON_BIN=python3
BLENDER_BIN=blender

# Serveur
PORT=8000
